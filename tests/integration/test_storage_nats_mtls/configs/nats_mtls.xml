<clickhouse>
    <!-- NATS mTLS configuration -->
    <nats>
        <!-- CA certificate for server verification -->
        <caConfig>/etc/clickhouse-server/config.d/ca-cert.pem</caConfig>

        <!-- Client certificate and key for mTLS authentication -->
        <certificateFile>/etc/clickhouse-server/config.d/client-cert.pem</certificateFile>
        <privateKeyFile>/etc/clickhouse-server/config.d/client-key.pem</privateKeyFile>

        <!-- TLS handshake before NATS INFO protocol -->
        <tlsHandshakeFirst>true</tlsHandshakeFirst>
    </nats>
</clickhouse>
